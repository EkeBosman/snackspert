# Kopieer dit bestand naar .env en vul het in. .env staat in .gitignore en
# hoort nooit in git terecht te komen.

SNACKSPERT_URL=https://snackspert.nl

# Het losse WordPress-account voor deze koppeling, niet je hoofdaccount.
SNACKSPERT_USER=Admin_Eke

# Application Password uit wp-admin > Gebruikers > Admin_Eke > Application
# Passwords. De spaties mogen erin blijven staan.
SNACKSPERT_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
