# Kopieer dit bestand naar .env en vul in wat je hebt. Alles is optioneel:
# zonder sleutels draait de tool in demomodus met verzonnen data.

# Apify (TikTok, Facebook, extra Instagram) - console.apify.com > Settings > API & Integrations
APIFY_TOKEN=

# Meta Graph API (gratis Instagram-hashtags en zakelijke accounts) - zie README
META_ACCESS_TOKEN=
META_IG_USER_ID=
META_GRAPH_VERSION=v25.0

# Claude (betere herkenning van producten, zaken en steden) - console.anthropic.com
ANTHROPIC_API_KEY=

# Zet op 1 om demomodus te forceren, ook als er sleutels zijn
TRENDRADAR_DEMO=
