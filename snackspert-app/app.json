{
  "expo": {
    "name": "Snackspert",
    "slug": "snackspert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "snackspert",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.snackspert.app",
      "config": {
        "googleMapsApiKey": "AIzaSyASmO1Ml_6yLt3JPInfd_5CJhA5eKMI9bg"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Snackspert gebruikt je locatie om restaurants bij jou in de buurt te tonen.",
        "LSApplicationQueriesSchemes": [
          "instagram",
          "tiktok"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "nl.snackspert.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1512"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyDkif9TtH9FtojtKmFSgEVMHh10QRf21tw"
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-location",
      [
        "expo-splash-screen",
        {
          "image": "./assets/SNACKSPERT_LOGO_SB_PIXEL.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#EDAA2D"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd962018-0ade-40ff-9d39-3f318f026d24"
      }
    }
  }
}
