{
  "expo": {
    "name": "Snackspert",
    "slug": "snackspert",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "snackspert",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#EDAA2D"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "nl.snackspert.app",
      "config": {
        "googleMapsApiKey": "AIzaSyASmO1Ml_6yLt3JPInfd_5CJhA5eKMI9bg"
      },
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Snackspert gebruikt je locatie om restaurants bij jou in de buurt te tonen.",
        "LSApplicationQueriesSchemes": ["instagram", "tiktok"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#EDAA2D"
      },
      "package": "nl.snackspert.app",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyASmO1Ml_6yLt3JPInfd_5CJhA5eKMI9bg"
        }
      }
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-location"
    ],
    "extra": {
      "eas": {
        "projectId": "fd962018-0ade-40ff-9d39-3f318f026d24"
      }
    }
  }
}
