# Instagram configuratie
INSTAGRAM_USERNAME=snackspert
# Optioneel: voor inloggen (nodig als profiel privé is)
INSTAGRAM_LOGIN_USERNAME=
INSTAGRAM_LOGIN_PASSWORD=

# Google API configuratie
# Pad naar het service account JSON-sleutelbestand
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json

# Google Drive map-ID waar de recensie-documenten worden opgeslagen
# Dit is het deel na /folders/ in de Google Drive URL
GOOGLE_DRIVE_FOLDER_ID=

# Optioneel: maximaal aantal posts om op te halen (0 = alles)
MAX_POSTS=0
